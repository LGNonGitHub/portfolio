@@ -0,0 +1,78 @@
+/**
+ * Section palettes as data.
+ *
+ * The same numbers live in CSS (globals.css for the fixed chrome, palettes.css
+ * for the per-section subtrees), because CSS needs them before any script runs.
+ * They are copied here so canvases and the GPU stage can read a palette
+ * without calling getComputedStyle, which is what left the old petals one
+ * anime behind. `npm run audit` (palette-parity) fails if the two drift.
+ *
+ * Every pair clears WCAG AA as text on its own section wash, in both themes.
+ */
+import type { Accent, SectionId, Theme } from '@/lib/runtime';
+
+export type RGB = readonly [number, number, number];
+export type Pair = readonly [RGB, RGB];
+
+export const PALETTES: Record<Theme, Record<SectionId, Pair>> = {
+  dark: {
+    // Hero and footer: the duality itself, green (剣) and purple (杖).
+    prologue: [[60, 214, 140], [162, 118, 255]],
+    // Black Clover: crimson and grimoire gold.
+    work: [[242, 85, 95], [232, 185, 74]],
+    // My Hero Academia: green lightning and hero gold.
+    about: [[74, 222, 128], [250, 204, 21]],
+    // Wistoria: wand violet and sky.
+    stack: [[167, 139, 250], [86, 200, 255]],
+    // Sword Art Online: HUD cyan and indigo.
+    path: [[34, 211, 238], [129, 140, 248]],
+    // The ending: monochrome, so all five series colours can roll past in it.
+    hobby: [[237, 235, 243], [158, 152, 176]],
+    // Fragrant Flower: blossom pink and lilac.
+    contact: [[249, 168, 212], [196, 181, 253]],
+  },
+  light: {
+    prologue: [[22, 110, 70], [88, 44, 170]],
+    work: [[176, 30, 43], [122, 92, 12]],
+    about: [[21, 128, 61], [161, 98, 7]],
+    stack: [[109, 40, 217], [3, 105, 161]],
+    path: [[14, 116, 144], [67, 56, 202]],
+    hobby: [[40, 34, 52], [84, 78, 98]],
+    contact: [[190, 24, 93], [109, 40, 217]],
+  },
+};
+
+/** Page background per theme (--bg). */
+export const BG: Record<Theme, RGB> = {
+  dark: [8, 6, 14],
+  light: [244, 243, 238],
+};
+
+/** The pair in leading order: the 剣/杖 switch swaps which half leads. */
+export function pairFor(theme: Theme, section: SectionId, accent: Accent): Pair {
+  const [c1, c2] = PALETTES[theme][section];
+  return accent === 'purple' ? [c2, c1] : [c1, c2];
+}
+
+const hex = (c: RGB) =>
+  '#' + c.map((v) => Math.round(v).toString(16).padStart(2, '0')).join('');
+
+/**
+ * The section's background wash as a hex colour: the leading accent mixed into
+ * the page background at 9% (dark) or 7% (light), the same mix .motif-field
+ * paints with color-mix(). Used for <meta name="theme-color">, so a phone's
+ * address bar takes on the section you are reading.
+ *
+ * The prologue has no wash, so it is the plain background.
+ */
+export function washHex(theme: Theme, section: SectionId, accent: Accent): string {
+  const bg = BG[theme];
+  if (section === 'prologue') return hex(bg);
+  const [lead] = pairFor(theme, section, accent);
+  const t = theme === 'dark' ? 0.09 : 0.07;
+  const mix = (i: 0 | 1 | 2) => lead[i] * t + bg[i] * (1 - t);
+  return hex([mix(0), mix(1), mix(2)]);
+}
+
+/** "r g b" channel string, the form the CSS custom properties use. */
+export const channels = (c: RGB) => c.join(' ');
diff --git a/src/lib/runtime.ts b/src/lib/runtime.ts
new file mode 100644
index 0000000..12ce260
--- /dev/null
+++ b/src/lib/runtime.ts
@@ -0,0 +1,221 @@
+/**
+ * The runtime store: one place that knows which section you are in, which
+ * theme and accent lead, and how much motion this visit gets.
+ *
+ * Before this, three components each ran their own IntersectionObserver, two
+ * canvases polled <html> with MutationObserver + getComputedStyle (and were
+ * measured running one palette behind), and three clocks ticked at 1 Hz.
+ * Everything now reads from here, and React reads it through
+ * useSyncExternalStore (src/hooks/useRuntime.ts), so there is no provider to
+ * thread and no re-render unless the slice you selected actually changed.
+ *
+ * Deliberately React-free: the frame ticker, the GL stage and plain DOM code
+ * can all subscribe without pulling in a hook.
+ */
+import { site } from '@/lib/content';
+import { formatTime } from '@/lib/utils';
+
+export type SectionId =
+  | 'prologue'
+  | 'work'
+  | 'about'
+  | 'stack'
+  | 'path'
+  | 'hobby'
+  | 'contact';
+
+/**
+ * full  — everything runs.
+ * lite  — chosen once per visit for slow devices: ambient work thins out.
+ * still — the visitor pressed 静: ambient loops pause, nothing drifts.
+ */
+export type Motion = 'full' | 'lite' | 'still';
+export type Theme = 'dark' | 'light';
+export type Accent = 'green' | 'purple';
+
+export type State = {
+  section: SectionId;
+  theme: Theme;
+  accent: Accent;
+  motion: Motion;
+};
+
+export const SECTION_IDS = [
+  'prologue',
+  'work',
+  'about',
+  'stack',
+  'path',
+  'hobby',
+  'contact',
+] as const satisfies readonly SectionId[];
+
+export const isSectionId = (v: unknown): v is SectionId =>
+  typeof v === 'string' && (SECTION_IDS as readonly string[]).includes(v);
+
+/** What the server renders with. Matches the SSR <html> attributes in layout.tsx. */
+export const SERVER_DEFAULT: State = Object.freeze({
+  section: 'prologue',
+  theme: 'dark',
+  accent: 'green',
+  motion: 'full',
+});
+
+const isBrowser = typeof window !== 'undefined';
+
+let state: State | null = null;
+/** What the device can carry. 'still' is a choice layered over it, so leaving
+ *  静 returns to the tier the device earned rather than always to 'full'. */
+let tier: 'full' | 'lite' = 'full';
+const listeners = new Set<() => void>();
+
+/** The inline theme script has already written the visitor's stored choices
+ *  onto <html> before first paint; seed from there so the store and the
+ *  painted page can never disagree. */
+function seed(): State {
+  const d = document.documentElement.dataset;
+  if (d.motion === 'lite') tier = 'lite';
+  return {
+    section: isSectionId(d.section) ? d.section : 'prologue',
+    theme: d.theme === 'light' ? 'light' : 'dark',
+    accent: d.accent === 'purple' ? 'purple' : 'green',
+    motion: d.motion === 'still' ? 'still' : d.motion === 'lite' ? 'lite' : 'full',
+  };
+}
+
+/** html[data-motion] carries 'still' or 'lite' for CSS; 'full' is the absence
+ *  of the attribute, so the SSR markup never has to guess. Only 'still' is
+ *  remembered — it is a preference. 'lite' is a measurement of this visit. */
+function mirrorMotion(next: Motion, prev: Motion) {
+  const root = document.documentElement;
+  if (next === 'full') root.removeAttribute('data-motion');
+  else root.dataset.motion = next;
+  try {
+    if (next === 'still') localStorage.setItem('motion', 'still');
+    else if (prev === 'still') localStorage.removeItem('motion');
+  } catch {
+    /* storage can be blocked; stillness still applies for this page */
+  }
+}
+
+export const runtime = {
+  get(): State {
+    if (!isBrowser) return SERVER_DEFAULT;
+    return (state ??= seed());
+  },
+
+  /** Shallow-merges, and only notifies when something actually changed, so a
+   *  scroll observer can call this as often as it likes. */
+  set(partial: Partial<State>) {
+    if (!isBrowser) return;
+    const prev = runtime.get();
+    let next: State | null = null;
+    for (const key of Object.keys(partial) as (keyof State)[]) {
+      const value = partial[key];
+      if (value === undefined || value === prev[key]) continue;
+      next ??= { ...prev };
+      (next as Record<keyof State, string>)[key] = value;
+    }
+    if (!next) return;
+    state = next;
+    if (next.motion !== prev.motion) mirrorMotion(next.motion, prev.motion);
+    listeners.forEach((fn) => fn());
+  },
+
+  subscribe(fn: () => void) {
+    listeners.add(fn);
+    return () => {
+      listeners.delete(fn);
+    };
+  },
+};
+
+/** The motion level to return to when 静 is released. */
+export const baseMotion = (): Motion => tier;
+
+/* ── One clock ──────────────────────────────────────────────────────────
+   Telemetry and the footer both show IST. They used to run an interval each
+   (three, counting the nav's). One interval now feeds every subscriber, starts
+   with the first and stops with the last, and is aligned to the wall-clock
+   second so the readout never lags the real time by most of a second. */
+
+let clock = '';
+let clockTimer = 0;
+const clockListeners = new Set<() => void>();
+
+function tickClock() {
+  clock = formatTime(new Date(), site.timezone);
+  clockListeners.forEach((fn) => fn());
+  clockTimer = window.setTimeout(tickClock, 1000 - (Date.now() % 1000) + 8);
+}
+
+export function subscribeClock(fn: () => void) {
+  clockListeners.add(fn);
+  if (clockListeners.size === 1 && isBrowser) tickClock();
+  return () => {
+    clockListeners.delete(fn);
+    if (clockListeners.size === 0) {
+      clearTimeout(clockTimer);
+      clockTimer = 0;
+    }
+  };
+}
+
+export const getClock = () => clock;
+
+/* ── Tier detection ─────────────────────────────────────────────────────
+   Decided once, after the intro has finished, so the cast itself is never
+   what gets measured, and never re-run, so a fast device is not demoted by
+   one bad second later on. The visitor's 静 always overrides it. */
+
+let tierDecided = false;
+
+export function detectTier() {
+  if (!isBrowser || tierDecided) return;
+  tierDecided = true;
+
+  // Stillness and reduced motion leave nothing ambient to budget for, and
+  // sampling would itself be 90 frames of the work they asked us not to do.
+  if (
+    runtime.get().motion === 'still' ||
+    window.matchMedia('(prefers-reduced-motion: reduce)').matches
+  ) {
+    return;
+  }
+
+  const demote = () => {
+    tier = 'lite';
+    if (runtime.get().motion === 'full') runtime.set({ motion: 'lite' });
+  };
+
+  const cores = navigator.hardwareConcurrency || 8;
+  if (cores <= 4) {
+    demote();
+    return;
+  }
+
+  const deltas: number[] = [];
+  let last = 0;
+  const sample = (t: number) => {
+    if (last) deltas.push(t - last);
+    last = t;
+    if (deltas.length < 90) {
+      requestAnimationFrame(sample);
+      return;
+    }
+    const sorted = deltas.sort((a, b) => a - b);
+    // Median, not mean: one GC pause should not cost a device its tier.
+    if (sorted[45] > 22) demote();
+  };
+
+  const start = () => requestAnimationFrame(sample);
+  if (document.visibilityState === 'visible') start();
+  else {
+    const onVisible = () => {
+      if (document.visibilityState !== 'visible') return;
+      document.removeEventListener('visibilitychange', onVisible);
+      start();
+    };
+    document.addEventListener('visibilitychange', onVisible);
+  }
+}
diff --git a/src/lib/transition.ts b/src/lib/transition.ts
new file mode 100644
index 0000000..7a29756
--- /dev/null
+++ b/src/lib/transition.ts
@@ -0,0 +1,83 @@
+/**
+ * Palette changes as a cut, not a fade.
+ *
+ * The theme and the 剣/杖 duality each repaint the whole page. Through a View
+ * Transition the new palette is revealed over the old one from the button
+ * that was pressed: the theme as a circle opening from the toggle, the sword
+ * as a diagonal slash, the wand as a bloom. Anime cuts between scenes the same
+ * way; a 700 ms crossfade of every colour on the page reads as a glitch.
+ *
+ * Falls back to a plain, instant update when the browser has no View
+ * Transitions, when the visitor prefers reduced motion, or under 静.
+ */
+import { flushSync } from 'react-dom';
+import { runtime } from '@/lib/runtime';
+import { EASE_OUT, cssEase } from '@/lib/motion';
+
+export type TransitionKind = 'theme' | 'sword' | 'wand';
+export type Origin = { x: number; y: number };
+
+const DURATION = 520;
+
+/** Radius that just reaches the farthest corner, so the reveal finishes exactly
+ *  as it covers the screen instead of spending its tail off-screen. */
+function coverRadius({ x, y }: Origin) {
+  const w = window.innerWidth;
+  const h = window.innerHeight;
+  return Math.hypot(Math.max(x, w - x), Math.max(y, h - y));
+}
+
+function clipFrames(kind: TransitionKind, origin: Origin): [string, string] {
+  if (kind === 'sword') {
+    // Equal vertex counts on both frames, so the polygon interpolates: a blade
+    // edge enters from the left and sweeps across on a slant.
+    return [
+      'polygon(-20% 0, -20% 0, -40% 100%, -40% 100%)',
+      'polygon(-20% 0, 140% 0, 120% 100%, -40% 100%)',
+    ];
+  }
+  const at = `at ${Math.round(origin.x)}px ${Math.round(origin.y)}px`;
+  return [`circle(0px ${at})`, `circle(${Math.ceil(coverRadius(origin))}px ${at})`];
+}
+
+/** The centre of an element, for passing as an origin. */
+export function centreOf(el: Element | null | undefined): Origin {
+  if (!el) return { x: window.innerWidth / 2, y: window.innerHeight / 2 };
+  const r = el.getBoundingClientRect();
+  return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
+}
+
+export function withTransition(update: () => void, kind: TransitionKind, origin: Origin) {
+  const doc = document as Document & {
+    startViewTransition?: Document['startViewTransition'];
+  };
+  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+  if (typeof doc.startViewTransition !== 'function' || reduced || runtime.get().motion === 'still') {
+    update();
+    return;
+  }
+
+  // flushSync so React has committed the new state (the sun/moon icon, the
+  // 剣/杖 glyph) before the browser snapshots the "after" frame.
+  const transition = doc.startViewTransition(() => flushSync(update));
+  const [from, to] = clipFrames(kind, origin);
+
+  transition.ready
+    .then(() => {
+      document.documentElement.animate(
+        { clipPath: [from, to] },
+        {
+          duration: DURATION,
+          easing: cssEase(EASE_OUT),
+          pseudoElement: '::view-transition-new(root)',
+        },
+      );
+    })
+    // A skipped transition (another toggle mid-flight, a hidden tab) rejects
+    // these. The update itself has still been applied, so there is nothing to
+    // recover; just keep the rejection out of the console.
+    .catch(() => {});
+  transition.finished.catch(() => {});
+  transition.updateCallbackDone.catch(() => {});
+}
diff --git a/src/styles/palettes.css b/src/styles/palettes.css
new file mode 100644
index 0000000..7e1e842
--- /dev/null
+++ b/src/styles/palettes.css
@@ -0,0 +1,163 @@
+/* ===========================================================================
+   SUBTREE PALETTES, STILLNESS, VIEW TRANSITIONS, FOCUS RETICLE
+
+   Plain CSS on purpose (no @apply, no @layer): these rules have to win by
+   specificity and source order alone, and they are parsed by the audit's
+   palette-parity gate, which compares every pair here and in globals.css with
+   src/lib/palettes.ts.
+   =========================================================================== */
+
+:root {
+  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
+  --ease-cast: cubic-bezier(0.65, 0, 0.35, 1);
+}
+
+/* Form controls, scrollbars and autofill follow the theme, not the OS. */
+:root {
+  color-scheme: light;
+}
+[data-theme='dark'] {
+  color-scheme: dark;
+}
+
+/* ── The ED: Hobby's chrome pair ──────────────────────────────────────────
+   globals.css owns the root-level pairs the fixed chrome (nav, telemetry,
+   scrollbar, selection) crossfades through. Hobby joins them here: the
+   ending is monochrome, so the chrome goes to ink and paper while the five
+   series colours roll past in the credits. */
+:root[data-section='hobby'] {
+  --c1r: 40;  --c1g: 34;  --c1b: 52;
+  --c2r: 84;  --c2g: 78;  --c2b: 98;
+}
+[data-theme='dark'][data-section='hobby'] {
+  --c1r: 237; --c1g: 235; --c1b: 243;
+  --c2r: 158; --c2g: 152; --c2b: 176;
+}
+
+/* ── Subtree palettes ──────────────────────────────────────────────────────
+   The global data-section only ever names ONE section, the one under the
+   viewport's centre line. Everything else on screen used to wear that
+   palette too, so a heading arriving from below showed up in the previous
+   anime's colours and recoloured itself half-way up the screen. A section
+   that carries data-palette always shows its own pair instead.
+
+   CRITICAL: :root declares --accent as var(--c1r) var(--c1g) var(--c1b), and
+   a custom property inherits as its already-substituted value. Overriding
+   only the channels below a scope would leave --accent holding the root's
+   numbers, so every scope re-declares the two composite tokens itself. */
+[data-palette] {
+  --accent: var(--c1r) var(--c1g) var(--c1b);
+  --accent-2: var(--c2r) var(--c2g) var(--c2b);
+}
+/* The 剣/杖 switch swaps which half leads, inside every scope too. */
+:root[data-accent='purple'] [data-palette] {
+  --accent: var(--c2r) var(--c2g) var(--c2b);
+  --accent-2: var(--c1r) var(--c1g) var(--c1b);
+}
+
+/* Light theme. */
+[data-palette='prologue'] { --c1r: 22;  --c1g: 110; --c1b: 70;  --c2r: 88;  --c2g: 44;  --c2b: 170; }
+[data-palette='work']     { --c1r: 176; --c1g: 30;  --c1b: 43;  --c2r: 122; --c2g: 92;  --c2b: 12;  }
+[data-palette='about']    { --c1r: 21;  --c1g: 128; --c1b: 61;  --c2r: 161; --c2g: 98;  --c2b: 7;   }
+[data-palette='stack']    { --c1r: 109; --c1g: 40;  --c1b: 217; --c2r: 3;   --c2g: 105; --c2b: 161; }
+[data-palette='path']     { --c1r: 14;  --c1g: 116; --c1b: 144; --c2r: 67;  --c2g: 56;  --c2b: 202; }
+[data-palette='hobby']    { --c1r: 40;  --c1g: 34;  --c1b: 52;  --c2r: 84;  --c2g: 78;  --c2b: 98;  }
+[data-palette='contact']  { --c1r: 190; --c1g: 24;  --c1b: 93;  --c2r: 109; --c2g: 40;  --c2b: 217; }
+
+/* Dark theme. One more attribute of specificity, so these win in dark. */
+[data-theme='dark'] [data-palette='prologue'] { --c1r: 60;  --c1g: 214; --c1b: 140; --c2r: 162; --c2g: 118; --c2b: 255; }
+[data-theme='dark'] [data-palette='work']     { --c1r: 242; --c1g: 85;  --c1b: 95;  --c2r: 232; --c2g: 185; --c2b: 74;  }
+[data-theme='dark'] [data-palette='about']    { --c1r: 74;  --c1g: 222; --c1b: 128; --c2r: 250; --c2g: 204; --c2b: 21;  }
+[data-theme='dark'] [data-palette='stack']    { --c1r: 167; --c1g: 139; --c1b: 250; --c2r: 86;  --c2g: 200; --c2b: 255; }
+[data-theme='dark'] [data-palette='path']     { --c1r: 34;  --c1g: 211; --c1b: 238; --c2r: 129; --c2g: 140; --c2b: 248; }
+[data-theme='dark'] [data-palette='hobby']    { --c1r: 237; --c1g: 235; --c1b: 243; --c2r: 158; --c2g: 152; --c2b: 176; }
+[data-theme='dark'] [data-palette='contact']  { --c1r: 249; --c1g: 168; --c1b: 212; --c2r: 196; --c2g: 181; --c2b: 253; }
+
+/* ── 静 Stillness ───────────────────────────────────────────────────────────
+   Paused, not removed: a spinning sigil stops where it is instead of
+   snapping back to zero, and the page keeps its composition. Transitions
+   are left alone; they answer the visitor, they are not ambient. */
+html[data-motion='still'] *,
+html[data-motion='still'] *::before,
+html[data-motion='still'] *::after {
+  animation-play-state: paused !important;
+}
+/* Without Lenis, anchors fall back to native scrolling; under 静 that should
+   be a cut, not globals.css's smooth glide. */
+html[data-motion='still'] {
+  scroll-behavior: auto !important;
+}
+
+/* ── View transitions ───────────────────────────────────────────────────
+   The theme and duality toggles reveal the new palette with a clip-path
+   animation (src/lib/transition.ts). The default crossfade would run
+   underneath it and wash the edge out, so it is switched off. */
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation: none;
+  mix-blend-mode: normal;
+}
+
+/* ── Focus reticle ──────────────────────────────────────────────────────
+   Four corner brackets that lock onto whatever keyboard focus lands on, in
+   the colour of the section the control lives in. Keyboard-only; never
+   moved by the pointer. The native outline stays underneath it, so it adds
+   to the focus indicator rather than replacing it.
+
+   The box itself is placed with a transform and sized to the control's rect
+   plus 4px; the brackets sit in its corners. Hidden means visibility:hidden
+   (after the fade), not just transparent, so it is out of hit-testing and
+   reads as hidden to anything that asks. */
+[data-focus-reticle] {
+  position: fixed;
+  left: 0;
+  top: 0;
+  width: 0;
+  height: 0;
+  z-index: 10003;
+  pointer-events: none;
+  opacity: 0;
+  visibility: hidden;
+  transition:
+    opacity 120ms var(--ease-out),
+    visibility 0s linear 120ms;
+}
+[data-focus-reticle][data-state='on'] {
+  opacity: 1;
+  visibility: visible;
+  transition: opacity 120ms var(--ease-out);
+}
+/* Snaps between targets; follows scrolling with no lag (no transition). */
+[data-focus-reticle][data-state='on'][data-snap] {
+  transition:
+    opacity 120ms var(--ease-out),
+    transform 120ms var(--ease-out),
+    width 120ms var(--ease-out),
+    height 120ms var(--ease-out);
+}
+[data-focus-reticle] > span {
+  position: absolute;
+  width: 10px;
+  height: 10px;
+  border: 0 solid rgb(var(--accent));
+}
+[data-focus-reticle] > [data-corner='tl'] { left: 0;  top: 0;    border-top-width: 1.5px;    border-left-width: 1.5px; }
+[data-focus-reticle] > [data-corner='tr'] { right: 0; top: 0;    border-top-width: 1.5px;    border-right-width: 1.5px; }
+[data-focus-reticle] > [data-corner='bl'] { left: 0;  bottom: 0; border-bottom-width: 1.5px; border-left-width: 1.5px; }
+[data-focus-reticle] > [data-corner='br'] { right: 0; bottom: 0; border-bottom-width: 1.5px; border-right-width: 1.5px; }
+
+@media (prefers-reduced-motion: reduce) {
+  [data-focus-reticle],
+  [data-focus-reticle][data-state='on'],
+  [data-focus-reticle][data-state='on'][data-snap] {
+    transition: none;
+  }
+}
+
+/* High-contrast modes draw their own system focus ring; brackets in an
+   author colour would only fight it. */
+@media (forced-colors: active) {
+  [data-focus-reticle] {
+    display: none !important;
+  }
+}
